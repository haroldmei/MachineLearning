      ],
      "updated": 1727084901042,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 5,
      "text": "Evaluation\n1. classification: Precision, recall, F1, ROC AUC, Accuracy, PR-AUC, confusion matrix\n2. regression: MSE, MAE, RMSE\n3. ranking: precision@K, recall@K, MRR, mAP, nDCG\n4. image gen: FID, Inception score\n5. NLP: BLEU, METEOR, ROUGE, CIDEr, SPICE\n6. Clustering: ARI\n\n\n8. Online: CTR, inc-sales, prevalence, valid appeals, DAU, total watch time, number of requests\n9. Others - fairness and bias\n",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Evaluation\n1. classification: Precision, recall, F1, ROC AUC, Accuracy, PR-AUC, confusion matrix\n2. regression: MSE, MAE, RMSE\n3. ranking: precision@K, recall@K, MRR, mAP, nDCG\n4. image gen: FID, Inception score\n5. NLP: BLEU, METEOR, ROUGE, CIDEr, SPICE\n6. Clustering: ARI\n\n\n8. Online: CTR, inc-sales, prevalence, valid appeals, DAU, total watch time, number of requests\n9. Others - fairness and bias\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
