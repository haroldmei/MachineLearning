    {
      "type": "text",
      "version": 3345,
      "versionNonce": 70984939,
      "index": "b5H",
      "isDeleted": false,
      "id": "wteZG_uMBVoIXhFureDMj",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 905.3300127179912,
      "y": 3645.173631408592,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 961.9393920898438,
      "height": 600,
      "seed": 326051739,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [
        {
          "id": "kqgRhSVkVW5czYUlJjY16",
          "type": "arrow"
        },
        {
          "id": "MFnZmQwG66dfOlerwMnGs",
